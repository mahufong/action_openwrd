# 2026 x86_64 OpenWrt/LEDE build profile
# Target: Unraid VM (J4125, 4 vCPU, 2 GB RAM)
# Goal: stable OpenClash + ZeroTier gateway with only the packages actually used.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Keep a tar rootfs artifact in addition to the normal x86 images.
# This VM boots with UEFI. Build only the useful compressed EFI image.
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y

# Main services
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_luci-app-zerotier=y
CONFIG_PACKAGE_luci-app-airplay2=y
CONFIG_PACKAGE_luci-app-uugamebooster=y

# UI: keep one maintained extra theme instead of compiling many legacy themes.
CONFIG_PACKAGE_luci-theme-argon=y

# Diagnostics useful for a virtual router.
# Do not install irqbalance by default: Lean x86 already includes autocore-x86
# and the build patches packet steering for this single-queue virtio NIC.
# qemu-ga is also omitted until the Unraid VM exposes org.qemu.guest_agent.0.
CONFIG_PACKAGE_luci-app-ttyd=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_vim=y

# OpenClash already provides the proxy stack. Do not build a second proxy suite.
# CONFIG_PACKAGE_luci-app-ssr-plus is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Shadowsocks is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_ShadowsocksR_Server is not set
# CONFIG_PACKAGE_luci-app-ssr-plus_INCLUDE_Xray is not set

# Keep the old access-control package disabled as in the previous profile.
# CONFIG_PACKAGE_luci-app-accesscontrol is not set

# Retire the old SFE/shortcut-fe selections. Current LEDE defaults to
# firewall4/nftables and ships luci-app-turboacc for acceleration management.
# CONFIG_PACKAGE_kmod-fast-classifier is not set
# CONFIG_PACKAGE_kmod-shortcut-fe is not set
# CONFIG_PACKAGE_kmod-shortcut-fe-cm is not set
